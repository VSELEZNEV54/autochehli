# Настройки бэкенда «Автостиль». Скопируйте в backend/.env и заполните. Файл .env не коммитить.

# development | production. В production бэкенд не запустится с тестовой кассой, без SECRET_KEY и без https
APP_ENV=production
SITE_URL=https://1avtochehol.ru
# Откуда разрешены формы и заказы (через запятую)
ALLOWED_ORIGINS=https://1avtochehol.ru,https://www.1avtochehol.ru
# Случайная строка от 32 символов: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
SECRET_KEY=

# Где лежит сайт (нужны js/data.js и js/app.js — из них сервер берёт каталог и цены)
SITE_ROOT=/var/www/avtostil
# База: по умолчанию SQLite в backend/data/avtostil.db. PostgreSQL:
# DATABASE_URL=postgresql+psycopg://avtostil:пароль@127.0.0.1:5432/avtostil
# В проде статику отдаёт nginx
SERVE_STATIC=0
# Адреса прокси, которым доверяем X-Real-IP / X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1,::1
# Админка только с этих адресов (необязательно, через запятую, можно подсети): 203.0.113.10,198.51.100.0/24
ADMIN_IP_ALLOWLIST=

# ---------- Оплата ----------
# yookassa | none (заказ без онлайн-оплаты, ссылку пришлёт менеджер) | mock (тестовая касса, только разработка)
PAYMENT_PROVIDER=yookassa
# Предоплата при оформлении, ₽ («предоплата от 1 000 ₽» на старом сайте)
PREPAY_AMOUNT=1000
# Личный кабинет ЮKassa → Интеграция → Ключи API. Для теста — тестовый магазин (ключ test_…)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# HTTP-уведомления в ЛК ЮKassa: URL https://1avtochehol.ru/api/payments/yookassa/webhook,
# события payment.succeeded, payment.canceled, refund.succeeded
YOOKASSA_CHECK_IP=1
# Чеки 54-ФЗ через ЮKassa («Чеки от ЮKassa» или подключённая касса). Ставку НДС и признак предоплаты подтверждает бухгалтер:
# YOOKASSA_VAT_CODE: 1 — без НДС, 2 — 0 %, 3 — 10 %, 4 — 20 %, 7 — 5 %, 8 — 7 % (по справочнику ЮKassa)
YOOKASSA_RECEIPTS=0
YOOKASSA_VAT_CODE=1
# Система налогообложения (1–6), если у магазина их несколько
YOOKASSA_TAX_SYSTEM=
# Признак способа расчёта для предоплаты: partial_prepayment или advance
YOOKASSA_PREPAY_MODE=partial_prepayment

# ---------- Уведомления менеджерам ----------
# Бот: @BotFather → токен; chat_id группы менеджеров — через @getmyid_bot или getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Почта (Яндекс 360: smtp.yandex.ru, 465, ssl)
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MANAGER_EMAILS=
# Письмо клиенту с номером заказа (если указал e-mail)
CUSTOMER_EMAILS=1

# ---------- Антиспам ----------
# Яндекс SmartCaptcha (необязательно): ключи из консоли Yandex Cloud
SMARTCAPTCHA_SERVER_KEY=
SMARTCAPTCHA_CLIENT_KEY=
# Форма, отправленная быстрее N секунд после открытия, — бот
MIN_FORM_SECONDS=3

# Номера заказов: AS-100001, AS-100002…
ORDER_NUMBER_START=100001
